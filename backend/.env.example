# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nautical_gourmet
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/nautical_gourmet

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# App
APP_NAME=Nautical Gourmet Atlas
DEBUG=true
API_V1_PREFIX=/v1

# Language
DEFAULT_LANGUAGE=en

# Context.dev — server-side key from https://www.context.dev. Leave empty to disable mapping.
CONTEXT_DEV_API_KEY=
CONTEXT_DEV_BASE_URL=https://api.context.dev/v1
